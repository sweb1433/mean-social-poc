# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# MongoDB Atlas connection string (M0 free cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/poc-app?retryWrites=true&w=majority

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AWS S3 (bucket for profile pictures, resumes, post attachments)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=your-bucket-name

# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY empty when running on EC2 with
# an attached IAM role - the SDK will pick up credentials automatically.
# Only fill them in for local development.

# First admin bootstrap (used by `npm run seed:admin`, optional convenience script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
